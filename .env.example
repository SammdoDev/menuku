# Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=6282264274973

# Supabase Settings > Database > Connection string. Keep server-only.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Optional server-only override. The default bucket name is "images".
SUPABASE_STORAGE_BUCKET=images

# Server-only. Jangan pernah expose key ini ke browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_EMAILS=admin@example.com

# Pakasir v2: server-only. Masukkan slug, API key, dan webhook secret dari proyek Pakasir.
# Atur URL webhook pada detail proyek ke https://www.digimenu.my.id/api/payments/pakasir/webhook.
PAKASIR_PROJECT_SLUG=your_pakasir_project_slug
PAKASIR_API_KEY=your_pakasir_api_key
PAKASIR_WEBHOOK_SECRET=your_pakasir_webhook_secret
PLAN_PREMIUM_PRICE=29000
PLAN_BUSINESS_PRICE=79000

# Email invoice/reminder. Isi nanti setelah Resend siap.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Menuku <billing@yourdomain.com>