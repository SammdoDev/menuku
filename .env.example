# Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Settings > Database > Connection string. Keep server-only.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Server-only. Needed later by the ImgBB upload route, never expose as NEXT_PUBLIC_.
IMGBB_API_KEY=
# Create three albums in ImgBB, then paste each album hash here.
IMGBB_ALBUM_PRODUCT=
IMGBB_ALBUM_BACKGROUND=
IMGBB_ALBUM_PROFILE=
