# Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=6282264274973

# Supabase Settings > Database > Connection string. Keep server-only.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Optional server-only override. The default bucket name is "images".
SUPABASE_STORAGE_BUCKET=images

# Server-only. Jangan pernah expose key ini ke browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_EMAILS=admin@example.com

# Duitku: server-only. Callback dan return URL harus memakai domain publik yang dapat diakses.
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=your_duitku_merchant_code
DUITKU_API_KEY=your_duitku_api_key
# Duitku dibatasi ke QRIS. Gunakan kode channel QRIS yang aktif di akun merchant.
DUITKU_PAYMENT_METHOD=SP
DUITKU_RETURN_URL=https://www.digimenu.my.id/dashboard/billing/confirmation
DUITKU_CALLBACK_URL=https://www.digimenu.my.id/api/payments/duitku/callback
# Optional override jika Duitku memberikan endpoint khusus.
# DUITKU_API_URL=https://api-sandbox.duitku.com/api/merchant/createInvoice

PLAN_PREMIUM_PRICE=29000
PLAN_BUSINESS_PRICE=79000

# Email invoice/reminder. Isi nanti setelah Resend siap.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Menuku <billing@yourdomain.com>
